    "express": "^5.2.1",
    "express-rate-limit": "^8.3.1",
    "file-type": "^21.3.3",
    "firebase-admin": "^10.3.0",
    "google-auth-library": "^10.6.2",
    "helmet": "^8.1.0",
    "imagekit": "^6.0.0",
    "ioredis": "^5.10.1",
    "jsonwebtoken": "^9.0.3",
